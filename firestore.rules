rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can access only their own private data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Invitation codes are created by the Bank and cannot be listed.
    match /groupCodes/{code} {
      allow create: if request.auth != null
                    && request.resource.data.bankId == request.auth.uid
                    && request.resource.data.groupId is string
                    && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.bankId == request.auth.uid;

      allow get: if request.auth != null;
      allow list: if false;
      allow update, delete: if false;
    }

    // Only the Bank manages groups; members may read group details.
    match /groups/{groupId} {
      allow create: if request.auth != null
                    && request.resource.data.bankId == request.auth.uid;

      allow read: if request.auth != null
                  && (
                    resource.data.bankId == request.auth.uid
                    || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                  );

      allow update, delete: if request.auth != null
                            && resource.data.bankId == request.auth.uid;

      // Members can join with a valid code; only the Bank can remove them.
      match /members/{userId} {
        allow read: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/groups/$(groupId)).data.bankId == request.auth.uid
                      || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                    );

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly([
                           "userId", "name", "role",
                           "groupCode", "membershipId", "joinedAt"
                         ])
                      && request.resource.data.keys().hasAll([
                           "userId", "name", "role",
                           "groupCode", "membershipId", "joinedAt"
                         ])
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.role == "member"
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.groupCode is string
                      && request.resource.data.groupCode.size() == 6
                      && request.resource.data.groupCode ==
                         get(/databases/$(database)/documents/groups/$(groupId)).data.groupCode
                      && request.resource.data.membershipId is string
                      && request.resource.data.membershipId.size() > 0
                      && request.resource.data.joinedAt is timestamp;

        allow update, delete: if request.auth != null
                              && get(/databases/$(database)/documents/groups/$(groupId)).data.bankId == request.auth.uid;
      }

      // Members may read session data; only the Bank may write it.
      match /{document=**} {
        allow read: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/groups/$(groupId)).data.bankId == request.auth.uid
                      || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                    );

        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/groups/$(groupId)).data.bankId == request.auth.uid;
      }
    }

  }
}
